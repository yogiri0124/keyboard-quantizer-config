diff --git a/tmk_core/protocol/chibios/usb_main.c b/tmk_core/protocol/chibios/usb_main.c
index 2024a3b..4de994c 100644
--- a/tmk_core/protocol/chibios/usb_main.c
+++ b/tmk_core/protocol/chibios/usb_main.c
@@ -605,9 +605,23 @@ __attribute__((weak)) void virtser_recv(uint8_t c) {
 }
 
 void virtser_task(void) {
-    uint8_t buffer[CDC_EPSIZE];
-    while (receive_report(USB_ENDPOINT_OUT_CDC_DATA, buffer, sizeof(buffer))) {
-        for (int i = 0; i < sizeof(buffer); i++) {
+    /* receive_report() only succeeds when a whole CDC_EPSIZE buffer arrives,
+     * so a short packet (e.g. one typed line) was read and then dropped.
+     * Hand over exactly the bytes that arrived instead. */
+    usb_endpoint_out_t *endpoint = &usb_endpoints_out[USB_ENDPOINT_OUT_CDC_DATA];
+    uint8_t             buffer[CDC_EPSIZE];
+    while (true) {
+        osalSysLock();
+        bool active = usbGetDriverStateI(endpoint->config.usbp) == USB_ACTIVE;
+        osalSysUnlock();
+        if (!active) {
+            break;
+        }
+        size_t received = ibqReadTimeout(&endpoint->ibqueue, buffer, sizeof(buffer), TIME_IMMEDIATE);
+        if (received == 0) {
+            break;
+        }
+        for (size_t i = 0; i < received; i++) {
             virtser_recv(buffer[i]);
         }
     }
