@@ -461,6 +461,16 @@ bool waiting_buffer_enq(keyrecord_t record) {
     return true;
 }
 
+/** \brief Room left in the waiting buffer
+ *
+ * Events a keyboard injects with action_exec() wait here while a tap-hold
+ * key is undecided, and an overflow clears the whole keyboard. This lets
+ * such a keyboard hold its own events back instead.
+ */
+uint8_t action_tapping_waiting_room(void) {
+    return (uint8_t)((waiting_buffer_tail + WAITING_BUFFER_SIZE - 1 - waiting_buffer_head) % WAITING_BUFFER_SIZE);
+}
+
